# URL interna da API (server-side only — nunca use NEXT_PUBLIC_ aqui).
# Dev local: http://localhost:3333 (porta padrão do repo `api`).
API_INTERNAL_URL=

# Client key exigida pela API no header X-Client-Key (ver repo `api`, CLIENT_KEY_WEB).
CLIENT_API_KEY=

# Cloudflare Turnstile (formulário de /suporte).
# Em dev, use as sitekeys de teste da Cloudflare — resolvem sozinhas, sem interação humana:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
