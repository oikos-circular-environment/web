# URL da API — fonte única, lida por server e client (ver src/lib/env.ts).
# Antes existia API_INTERNAL_URL (server-only); os dois valores eram idênticos na
# prática, então passou a existir só esta variável pública.
NEXT_PUBLIC_API_URL=http://localhost:3333

# Client key exigida pela API no header X-Client-Key (ver repo `api`, CLIENT_KEY_WEB).
# Variante pública usada pelo client singleton do browser (src/libs/api/oikos-api.ts);
# no server, o mesmo valor vem de CLIENT_API_KEY.
CLIENT_API_KEY=
NEXT_PUBLIC_CLIENT_API_KEY=

# Credenciais do HTTP Basic Auth da rota /docs/openapi.json da api local (dev), usadas
# pelo `npm run generate:sdk` (openapi-ts.config.ts). Mesmos valores do repo `api`
# (ADMIN_USERNAME/ADMIN_PASSWORD) — não confundir com segredo de produção.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cloudflare Turnstile (formulário de /suporte).
# Em dev, use as sitekeys de teste da Cloudflare — resolvem sozinhas, sem interação humana:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
