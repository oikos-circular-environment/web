# Toda variável abaixo é lida por src/libs/env.ts — nunca via process.env direto em página,
# action ou componente.

# URL da API — fonte única, lida por server e client.
# Antes existia API_INTERNAL_URL (server-only); os dois valores eram idênticos na
# prática, então passou a existir só esta variável pública.
NEXT_PUBLIC_API_URL=http://localhost:3333

# Client key exigida pela API no header X-Client-Key (ver repo `api`, CLIENT_KEY_WEB).
# Server-only — nunca exponha ao client.
CLIENT_API_KEY=

# Token com read:packages para instalar @oikos-circular-environment/oikos-sdk do GitHub Packages
# (lido pelo .npmrc). Em CI vem do secret GH_TOKEN_PERSONAL_TOKEN.
GH_TOKEN_PERSONAL_TOKEN=

# Cloudflare Turnstile (formulário de /suporte).
# Em dev, use as sitekeys de teste da Cloudflare — resolvem sozinhas, sem interação humana:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OpenTelemetry (src/instrumentation.ts). Sem esta variável o register() é no-op — em dev
# local deixe vazia. Em produção aponta pro collector (ver repo `devops`).
OTEL_EXPORTER_OTLP_ENDPOINT=
